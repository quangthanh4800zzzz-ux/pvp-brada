{
  "name": "pixel-rift-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "preview": "npm run preview -w client",
    "server": "npm run dev -w server",
    "sprites": "npm run generate -w client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p client && tsc --noEmit -p server"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.9"
  }
}
